pipeline {

    agent any

    stages {

        stage('Clone Repository') {
            steps {
                git branch: 'main',
                url: 'https://github.com/riyasingh2119/Blue-Green_Devops_Project.git'
            }
        }

        stage('Project Structure Check') {
            steps {
                sh 'ls'
            }
        }

        stage('Docker Files Verification') {
            steps {
                sh 'test -f docker-compose.yml'
                sh 'test -f backend/Dockerfile'
                sh 'test -f frontend/Dockerfile'
            }
        }

        stage('Pipeline Success') {
            steps {
                echo 'CI/CD Pipeline Executed Successfully'
            }
        }

    }
}